# Copy this file to ".env" in the project root and fill in your key.
# NEVER commit your real ".env" file to GitHub!

# Sarvam AI (used in Part 3 for Hindi/English coach + voice)
# Leave blank to run in 100% offline fallback mode.
SARVAM_API_KEY=

# Optional Sarvam model overrides
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_SPEAKER=simran
